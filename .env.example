# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku)
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillswap?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# JWT Secret Key for user authentication tokens
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars

# Allowed client origin(s) for CORS (comma-separated for multiple, or leave blank to allow all)
# Example: https://skillswap.vercel.app,http://localhost:5173
CLIENT_URL=